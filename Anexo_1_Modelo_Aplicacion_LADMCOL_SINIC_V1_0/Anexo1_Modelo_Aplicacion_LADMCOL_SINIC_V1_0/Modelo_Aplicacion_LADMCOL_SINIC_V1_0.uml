<ch.ehi.basics.types.NlsString TID="6288">
<Entry TID="6332" language="es" translation="Clase especializada de BaUnit, que describe al predio como la unidad administrativa b&#225;sica para la gesti&#243;n catastral con enfoque multiprop&#243;sito en Colombia.&#10;&#10;Predio: inmueble con o sin t&#237;tulo registrado, no separado por otro predio, con o sin unidades de construcci&#243;n y vinculado con personas naturales o jur&#237;dicas, seg&#250;n su relaci&#243;n de tenencia: propietario, poseedor u ocupante."/>
</ch.ehi.basics.types.NlsString>
