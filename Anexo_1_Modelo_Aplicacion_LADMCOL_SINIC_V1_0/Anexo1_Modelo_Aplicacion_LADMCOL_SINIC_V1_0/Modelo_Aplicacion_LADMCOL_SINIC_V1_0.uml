<ch.ehi.basics.types.NlsString TID="4750">
<Entry TID="4751" language="es" translation="Se califica con destino Cultural, aquellos predios considerados como bienes culturales de la naci&#243;n, adem&#225;s los espacios destinados al desarrollo de actividades art&#237;sticas.&#10;"/>
</ch.ehi.basics.types.NlsString>
