<ch.ehi.basics.types.NlsString TID="3913">
<Entry TID="3914" language="es" translation="Dep&#243;sitos subterr&#225;neos o de altura, construidos en zonas con deficiencias en abastecimiento para el consumo de los habitantes o para el uso agr&#237;cola.  El elemento a calificar es la estructura relacionada con la capacidad de almacenamiento medida en metros c&#250;bicos.&#10;&#10;Se excluyen de este tipo de construcci&#243;n los tanques de almacenamiento domiciliario.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="3906">
<Entry TID="3915" language="es" translation="EnumElement4442"/>
</ch.ehi.basics.types.NlsString>
