<ch.ehi.basics.types.NlsString TID="7353">
<Entry TID="7355" language="es" translation="Incorporaci&#243;n de datos complementarios a la informaci&#243;n de las mutaciones catastrales.&#10;Cada gestor catastral incorporara los datos adicionales o complementarios que considere necesarios para enriquecer la informaci&#243;n de los predios en su jurisdicci&#243;n."/>
</ch.ehi.basics.types.NlsString>
