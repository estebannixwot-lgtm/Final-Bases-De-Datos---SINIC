<Entry TID="7415" language="es" translation="Acto mediante el cual se realiza la modificaci&#243;n de los estudios econ&#243;micos que no provienen de errores en la informaci&#243;n catastral.&#10;"/>
</ch.ehi.basics.types.NlsString>
