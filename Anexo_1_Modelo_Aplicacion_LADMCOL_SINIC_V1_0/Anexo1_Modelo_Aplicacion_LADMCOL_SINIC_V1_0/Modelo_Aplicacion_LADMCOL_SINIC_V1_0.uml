<Entry TID="7397" language="es" translation="EnumElement89"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7396">
<Entry TID="7398" language="es" translation="Acto mediante el cual, a trav&#233;s de la separaci&#243;n de un predio, se crean uno o m&#225;s predios nuevos, con o sin cambio de propietario,   este acto deber&#225; estar soportado en el registro p&#250;blico de la propiedad.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7394">
<Entry TID="7399" language="es" translation="Segregacion"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7342">
<Entry TID="7400" language="es" translation="EnumElement100"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7346">
<Entry TID="7401" language="es" translation="Acto mediante el cual se rectifica la inscripci&#243;n de un predio dentro de la base catastral.&#10;Es importante destacar que esta rectificacion tendr&#225; efecto &#250;nicamente para fines catastrales. Si se requiere una rectificaci&#243;n con efectos registrales, se deber&#225;n seguir las directrices establecidas en la normatividad vigente."/>
</ch.ehi.basics.types.NlsString>
