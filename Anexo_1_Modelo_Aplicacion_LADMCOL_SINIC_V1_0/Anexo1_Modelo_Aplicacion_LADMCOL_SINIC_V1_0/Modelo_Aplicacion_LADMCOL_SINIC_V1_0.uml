<Entry TID="4798" language="es" translation="Agroforestal"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="4797">
<Entry TID="4799" language="es" translation="Se califica con destino agroforestal, aquellos predios destinados al establecimiento y aprovechamiento combinado de especies forestales con actividades agr&#237;colas o pecuarias con arreglos diferenciados. Incluye la actividad agrosilv&#237;cola, silvopastoril y agrosilvopastoril.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="4690">
<Entry TID="4800" language="es" translation="EnumElement106"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="4729">
<Entry TID="4801" language="es" translation="Se califica con destino industrial, aquellos predios donde se desarrollan actividades de producci&#243;n, fabricaci&#243;n, preparaci&#243;n, recuperaci&#243;n, reproducci&#243;n, ensamblaje, construcci&#243;n, transformaci&#243;n, tratamiento y manipulaci&#243;n de materias primas para producir bienes o productos materiales y que no est&#233;n clasificados dentro de los predios mineros.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="4748">
<Entry TID="4802" language="es" translation="Cultural"/>
</ch.ehi.basics.types.NlsString>
