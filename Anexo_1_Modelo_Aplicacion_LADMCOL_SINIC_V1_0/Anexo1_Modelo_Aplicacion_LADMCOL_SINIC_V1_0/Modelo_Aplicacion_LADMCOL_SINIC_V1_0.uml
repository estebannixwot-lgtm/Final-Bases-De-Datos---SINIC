<ch.ehi.basics.types.NlsString TID="4694">
<Entry TID="4741" language="es" translation="Se califica con destino agr&#237;cola, aquellos predios con funcionalidad de laboreo agr&#237;cola, terrenos que han sido transformados y ocupados para la producci&#243;n de cultivos cuyo objetivo es satisfacer las necesidades alimentarias, comerciales y agr&#237;colas.&#10;"/>
