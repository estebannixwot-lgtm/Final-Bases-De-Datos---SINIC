</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7418">
<Entry TID="7420" language="es" translation="Proceso mediante el cual se ajusta el aval&#250;o catastral asignado a un predio, cuando el valor no corresponde a sus caracter&#237;sticas y condiciones.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7417">
