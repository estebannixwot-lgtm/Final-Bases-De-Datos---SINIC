<Entry TID="7409" language="es" translation="Autoestimacion_Avaluo"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7408">
<Entry TID="7410" language="es" translation="Proceso mediante el cual se adopta el aval&#250;o catastral en funci&#243;n de la estimaci&#243;n del valor de un inmueble. Dicha estimaci&#243;n no podr&#225; ser inferior al aval&#250;o catastral vigente.&#10;"/>
</ch.ehi.basics.types.NlsString>
