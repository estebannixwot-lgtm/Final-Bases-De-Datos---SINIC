<ch.ehi.basics.types.NlsString TID="4677">
<Entry TID="4696" language="es" translation="Se califica con destino institucional, aquellos predios destinados a la administraci&#243;n y prestaci&#243;n de servicios del Estado tanto de orden nacional como territorial.&#10;"/>
</ch.ehi.basics.types.NlsString>
