<ch.ehi.basics.types.NlsString TID="4713">
<Entry TID="4715" language="es" translation="Se califica con destino Servicios Sociales, aquellos predios que generan un beneficio social a la comunidad y que sean de propiedad de una organizaci&#243;n sin animo de lucro, por ejemplo hogares geri&#225;tricos, fundaciones, entre otros.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="4711">
<Entry TID="4716" language="es" translation="Servicios_Sociales"/>
