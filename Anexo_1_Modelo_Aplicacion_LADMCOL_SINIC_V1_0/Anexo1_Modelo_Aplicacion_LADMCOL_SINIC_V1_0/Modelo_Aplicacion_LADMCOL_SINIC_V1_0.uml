</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7364">
<Entry TID="7367" language="es" translation="Son cambios en la base de datos catastral que no provienen de errores de la informaci&#243;n en los procesos de actualizaci&#243;n o conservaci&#243;n catastral.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7330">
<Entry TID="7368" language="es" translation="EnumElement273"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7307">
<Entry TID="7369" language="es" translation="EnumElement271"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7357">
<Entry TID="7370" language="es" translation="Predios_Nuevos_Informales"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7318">
<Entry TID="7371" language="es" translation="Son las que resultan de la incorporaci&#243;n de predios formales o bajo la condici&#243;n de informalidad que no estaban incorporados previamente en la base de datos catastral."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.interlis.domainsandconstants.basetypes.EnumElement TID="7297">
