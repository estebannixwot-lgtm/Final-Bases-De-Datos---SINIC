</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="4697">
<Entry TID="4700" language="es" translation="Infraestructura_Saneamiento_Basico"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="4699">
<Entry TID="4701" language="es" translation="Se califica con destino Infraestructura de Saneamiento B&#225;sico, aquellos predios sobre los cuales se encuentra establecida la infraestructura para el saneamiento b&#225;sico. Incluye los centros de acopio de basura y material reciclable, rellenos sanitarios e incineradoras, alcantarillados y las estaciones depuradoras de aguas residuales.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.interlis.domainsandconstants.basetypes.EnumElement TID="4638">
<Name>4702</Name>
