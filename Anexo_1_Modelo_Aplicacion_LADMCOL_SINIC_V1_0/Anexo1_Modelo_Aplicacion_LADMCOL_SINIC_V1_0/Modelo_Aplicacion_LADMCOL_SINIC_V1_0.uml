<ch.ehi.basics.types.NlsString TID="4972">
<Entry TID="4974" language="es" translation="&quot;Seg&#250;n la Corte Constitucional (sentencia T-445-22), las personas tienen el derecho a auto reconocerse como pertenecientes a cualquier etnia si subjetivamente considera que tiene los v&#237;nculos culturales, familiares o hist&#243;ricos.&#10;&#10;En este sentido, la persona puede auto reconocerse como ind&#237;gena, gitano Roman&#237;, raizal, palenquero, negro o afrocolombiano&quot;&#10;"/>
</ch.ehi.basics.types.NlsString>
