</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="7425">
<Entry TID="7426" language="es" translation="Proceso por el cual se actualiza el valor de los aval&#250;os catastrales cada primero (1) de enero, bas&#225;ndose en el porcentaje definido por el Gobierno nacional. Adicionalmente, los catastros descentralizados pueden determinar el porcentaje de actualizaci&#243;n conforme a los &#237;ndices de valoraci&#243;n inmobiliaria y con la aprobaci&#243;n del Consejo de Pol&#237;tica Econ&#243;mica y Fiscal del ente territorial.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7424">
